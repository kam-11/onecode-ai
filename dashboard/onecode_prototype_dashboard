<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>OneCode AI — Material Resolution Console</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#12293C;
    --steel:#1F4E63;
    --teal:#146B63;
    --teal-bg:#E6F1EF;
    --amber:#9A6112;
    --amber-bg:#FBF0DD;
    --red:#8F3226;
    --red-bg:#F8E9E5;
    --slate:#4C616A;
    --paper:#EDF0EE;
    --panel:#FFFFFF;
    --line:#D7DED9;
    --mono:'IBM Plex Mono', monospace;
    --sans:'IBM Plex Sans', sans-serif;
  }
  *{box-sizing:border-box;}
  body{
    margin:0; font-family:var(--sans); background:var(--paper); color:var(--ink);
    -webkit-font-smoothing:antialiased;
  }
  .console{max-width:1080px;margin:0 auto;padding:0 0 48px;}

  /* header */
  .header{
    background:linear-gradient(135deg, var(--ink) 0%, var(--steel) 100%);
    color:#EAF2F1; padding:28px 32px 24px; position:relative; overflow:hidden;
  }
  .header::after{
    content:""; position:absolute; right:-40px; top:-40px; width:220px; height:220px;
    border:1px solid rgba(255,255,255,0.08); border-radius:50%;
  }
  .header::before{
    content:""; position:absolute; right:20px; top:40px; width:140px; height:140px;
    border:1px solid rgba(255,255,255,0.06); border-radius:50%;
  }
  .eyebrow{font-family:var(--mono); font-size:11px; letter-spacing:0.04em; color:#9FC3BD; margin:0 0 6px;}
  .h1{font-size:26px; font-weight:700; margin:0 0 4px; letter-spacing:-0.01em;}
  .h1 small{font-weight:400; color:#B9D2CD; font-size:16px;}
  .sub{font-size:13.5px; color:#C4D6D2; max-width:640px; line-height:1.5; margin:0;}

  /* stat strip */
  .stats{
    display:grid; grid-template-columns:repeat(4,1fr); gap:1px; background:var(--line);
    border:1px solid var(--line); margin:0 32px; transform:translateY(-1px);
  }
  .stat{background:var(--panel); padding:16px 18px;}
  .stat .num{font-family:var(--mono); font-size:24px; font-weight:600; color:var(--ink);}
  .stat .lbl{font-size:11.5px; color:var(--slate); margin-top:3px; line-height:1.35;}
  .stat.good .num{color:var(--teal);}

  .section{padding:28px 32px 0;}
  .section-title{
    font-size:13px; font-weight:600; text-transform:uppercase; letter-spacing:0.05em;
    color:var(--slate); margin:0 0 14px; display:flex; align-items:center; gap:8px;
  }
  .section-title::after{content:""; flex:1; height:1px; background:var(--line);}

  /* decision distribution */
  .dist{display:flex; flex-direction:column; gap:8px;}
  .dist-row{display:grid; grid-template-columns:170px 1fr 40px; align-items:center; gap:10px;}
  .dist-label{font-size:13px; font-weight:500;}
  .dist-track{background:#E2E7E4; border-radius:3px; height:16px; overflow:hidden;}
  .dist-fill{height:100%; border-radius:3px;}
  .dist-count{font-family:var(--mono); font-size:13px; color:var(--slate); text-align:right;}

  /* spotlight card */
  .spotlight{
    background:var(--red-bg); border:1px solid #E4C4BB; border-radius:6px; padding:18px 20px;
    display:grid; grid-template-columns:1fr 1fr; gap:18px;
  }
  .spot-col .tag{font-family:var(--mono); font-size:10.5px; color:var(--red); letter-spacing:0.04em; margin-bottom:6px; display:block;}
  .spot-desc{font-size:14px; font-weight:500; color:var(--ink); line-height:1.4;}
  .spot-code{font-family:var(--mono); font-size:11.5px; color:var(--slate); margin-top:4px;}
  .spot-verdict{
    grid-column:1 / -1; border-top:1px solid #E4C4BB; padding-top:12px; margin-top:2px;
    font-size:13.5px; color:var(--red); line-height:1.5;
  }
  .spot-verdict b{color:var(--ink);}

  /* filter tabs */
  .tabs{display:flex; flex-wrap:wrap; gap:6px; margin-bottom:14px;}
  .tab{
    font-family:var(--sans); font-size:12.5px; font-weight:500; padding:6px 12px;
    border-radius:20px; border:1px solid var(--line); background:var(--panel); color:var(--slate);
    cursor:pointer; transition:all .12s ease;
  }
  .tab:hover{border-color:var(--steel);}
  .tab.active{background:var(--ink); color:#fff; border-color:var(--ink);}

  /* results table */
  .results{border:1px solid var(--line); border-radius:6px; overflow:hidden; background:var(--panel);}
  .result-row{
    display:grid; grid-template-columns:96px 1fr 130px 90px; gap:14px; padding:13px 16px;
    border-bottom:1px solid var(--line); align-items:start;
  }
  .result-row:last-child{border-bottom:none;}
  .result-row:hover{background:#F7F9F8;}
  .r-cat{font-family:var(--mono); font-size:11px; color:var(--slate); padding-top:2px;}
  .r-main .r-desc{font-size:13.5px; line-height:1.45; color:var(--ink);}
  .r-main .r-desc .vs{color:var(--slate); font-weight:400; margin:0 6px;}
  .r-main .r-evidence{font-size:12px; color:var(--slate); margin-top:5px; line-height:1.4;}
  .r-score{font-family:var(--mono); font-size:11.5px; color:var(--slate); text-align:right; padding-top:2px; line-height:1.6;}
  .r-score b{color:var(--ink); font-size:13px;}
  .badge{
    font-family:var(--mono); font-size:10.5px; font-weight:600; padding:3px 9px;
    border-radius:3px; display:inline-block; white-space:nowrap; letter-spacing:0.01em;
  }
  .badge-exact{background:var(--teal-bg); color:var(--teal);}
  .badge-functional{background:#E4EEF6; color:#265E85;}
  .badge-near{background:var(--amber-bg); color:var(--amber);}
  .badge-not{background:var(--red-bg); color:var(--red);}
  .badge-insuff{background:#EEEBF3; color:#5B4A82;}

  /* audit log */
  .audit{border:1px solid var(--line); border-radius:6px; background:var(--panel); overflow:hidden;}
  .audit-row{
    display:flex; justify-content:space-between; gap:12px; padding:9px 16px; font-size:12px;
    border-bottom:1px solid var(--line); color:var(--slate); font-family:var(--mono);
  }
  .audit-row:last-child{border-bottom:none;}
  .audit-row .a-status{color:var(--amber); font-weight:600;}

  .footnote{padding:24px 32px 0; font-size:11.5px; color:var(--slate); line-height:1.6; max-width:680px;}
</style>
</head>
