  "Functional Equivalent":{ badge: "badge-functional", bar: "#265E85" },
  "Near Duplicate":       { badge: "badge-near",       bar: "#9A6112" },
  "Not Equivalent":       { badge: "badge-not",        bar: "#8F3226" },
  "Insufficient Data":    { badge: "badge-insuff",     bar: "#5B4A82" },
};

function el(html){ const d = document.createElement('div'); d.innerHTML = html.trim(); return d.firstChild; }

// ---- stat strip ----
const out = DATA.output, metrics = DATA.metrics;
const statStrip = document.getElementById('statStrip');
const stats = [
  { num: out.total_records, lbl: "Material records ingested" },
  { num: out.candidate_pairs_evaluated + ' / ' + out.full_pairwise_would_be, lbl: "Pairs compared vs. full pairwise" },
  { num: out.compute_saved_by_blocking_pct + '%', lbl: "Compute saved by blocking before scoring", good:true },
  { num: (metrics.false_merge_rate_on_critical_conflicts*100).toFixed(0) + '%', lbl: metrics.critical_conflict_cases_evaluated + ' critical-attribute conflicts — false merge rate', good:true },
];
stats.forEach(s => statStrip.appendChild(el(`<div class="stat ${s.good?'good':''}"><div class="num">${s.num}</div><div class="lbl">${s.lbl}</div></div>`)));

// ---- decision distribution ----
const counts = {};
out.results.forEach(r => counts[r.decision] = (counts[r.decision]||0)+1);
const maxCount = Math.max(...Object.values(counts));
const distChart = document.getElementById('distChart');
Object.keys(DECISION_META).forEach(dec => {
  const c = counts[dec] || 0;
  const pct = maxCount ? (c/maxCount*100) : 0;
  distChart.appendChild(el(`
    <div class="dist-row">
      <div class="dist-label">${dec}</div>
      <div class="dist-track"><div class="dist-fill" style="width:${pct}%;background:${DECISION_META[dec].bar}"></div></div>
      <div class="dist-count">${c}</div>
    </div>
  `));
});

// ---- spotlight: pick a Not Equivalent case caused by a critical grade conflict ----
const spotCase = out.results.find(r => r.decision === "Not Equivalent" && r.evidence.includes("grade"));
if (spotCase) {
  document.getElementById('spotlight').innerHTML = `
    <div class="spot-col">
      <span class="tag">${spotCase.cpse_pair[0]} · ${spotCase.pair[0]}</span>
      <div class="spot-desc">${spotCase.descriptions[0]}</div>
    </div>
    <div class="spot-col">
      <span class="tag">${spotCase.cpse_pair[1]} · ${spotCase.pair[1]}</span>
      <div class="spot-desc">${spotCase.descriptions[1]}</div>
    </div>
    <div class="spot-verdict"><b>Blocked, not merged.</b> Text similarity alone was high (${(spotCase.fuzzy_score*100).toFixed(0)}% fuzzy match) — the descriptions read almost identically. ${spotCase.evidence}. A safety-critical attribute mismatch overrides similarity score every time, regardless of how close the wording looks.</div>
  `;
}

// ---- results table with filter tabs ----
const tabsEl = document.getElementById('tabs');
const tableEl = document.getElementById('resultsTable');
const decisionsPresent = ["All", ...Object.keys(DECISION_META)];
let activeFilter = "All";

function renderTable(){
  tableEl.innerHTML = "";
  const rows = out.results.filter(r => activeFilter === "All" || r.decision === activeFilter);
  rows.forEach(r => {
    const meta = DECISION_META[r.decision];
    tableEl.appendChild(el(`
      <div class="result-row">
        <div class="r-cat">${r.category}<br><span class="badge ${meta.badge}" style="margin-top:6px;">${r.decision}</span></div>
        <div class="r-main">
          <div class="r-desc">${r.descriptions[0]}<span class="vs">vs</span>${r.descriptions[1]}</div>
          <div class="r-evidence">${r.evidence}</div>
        </div>
        <div class="r-score">
          score <b>${r.combined_score.toFixed(2)}</b><br>
          fuzzy ${r.fuzzy_score.toFixed(2)} · attr ${(r.attribute_agreement*100).toFixed(0)}%
        </div>
        <div class="r-cat" style="text-align:right;">${r.cpse_pair[0]}<br>${r.cpse_pair[1]}</div>
      </div>
    `));
  });
  if (rows.length === 0) {
    tableEl.appendChild(el(`<div class="result-row"><div class="r-main" style="grid-column:1/-1;color:var(--slate);">No results in this category.</div></div>`));
  }
}

decisionsPresent.forEach(dec => {
  const tab = el(`<button class="tab ${dec==='All'?'active':''}">${dec}${dec!=="All" ? ' ('+(counts[dec]||0)+')' : ''}</button>`);
  tab.addEventListener('click', () => {
    activeFilter = dec;
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    tab.classList.add('active');
    renderTable();
  });
  tabsEl.appendChild(tab);
});
renderTable();

// ---- audit log ----
const auditEl = document.getElementById('auditLog');
out.audit_log.forEach(a => {
  const t = new Date(a.timestamp);
  auditEl.appendChild(el(`
    <div class="audit-row">
      <span>${a.materials[0]} ↔ ${a.materials[1]} — ${a.decision}</span>
      <span class="a-status">${a.status.replace(/_/g,' ')}</span>
    </div>
  `));
});
